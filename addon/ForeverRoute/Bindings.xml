<Bindings>
  <!-- ForeverRoute's key actions, kept so keys bound to them aren't lost before Beeline moves them to its own
       (Migrate.lua), and so they still work if that move hasn't happened yet. Each does what Beeline's does. -->
  <Binding name="FOREVERROUTE_SKIP" header="FOREVERROUTE" category="ADDONS">if Beeline then Beeline.Engine.Skip() end</Binding>
  <Binding name="FOREVERROUTE_BACK" category="ADDONS">if Beeline then Beeline.Engine.Back() end</Binding>
  <Binding name="FOREVERROUTE_UNDO" category="ADDONS">if Beeline then Beeline.Engine.Undo() end</Binding>
  <Binding name="FOREVERROUTE_TOGGLE" category="ADDONS">if Beeline then Beeline.Fire("FR_TOGGLE") end</Binding>
  <Binding name="FOREVERROUTE_LIST" category="ADDONS">if Beeline then Beeline.Fire("FR_TOGGLE_LIST") end</Binding>
  <Binding name="CLICK ForeverRouteTargetButton:LeftButton" category="ADDONS"/>
</Bindings>
